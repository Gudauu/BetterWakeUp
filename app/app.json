{
  "expo": {
    "name": "BetterWakeUp",
    "slug": "betterwakeup",
    "scheme": "betterwakeup",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.betterwakeup.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "BetterWakeUp counts your steps while the app is open to confirm you completed a wake-up task."
      }
    },
    "android": {
      "package": "com.betterwakeup.app",
      "permissions": ["android.permission.ACTIVITY_RECOGNITION"]
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-secure-store", "expo-apple-authentication"],
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
