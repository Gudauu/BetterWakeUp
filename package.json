{
  "name": "betterwakeup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "biome ci .",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --no-bail run typecheck",
    "test": "vitest run && pnpm --filter @betterwakeup/app run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
