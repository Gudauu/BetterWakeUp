{
  "name": "betterwakeup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
